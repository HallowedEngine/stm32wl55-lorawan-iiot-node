      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "InfluxDB-IIoT"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"iiot_telemetry\")\n  |> filter(fn: (r) => r._field == \"battery_mv\")\n  |> group(columns: [\"dev_eui\"])\n  |> last()\n  |> map(fn: (r) => ({dev_eui: r.dev_eui, battery_mv: r._value, last_seen: r._time}))\n  |> group()\n  |> keep(columns: [\"dev_eui\", \"battery_mv\", \"last_seen\"])\n  |> yield(name: \"battery_status\")",
          "refId": "A"
